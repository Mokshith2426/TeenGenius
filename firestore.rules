rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    match /test/connection {
      allow read: if true;
    }

    // --- User Validation ---
    // Social and gamification fields were removed with the collaboration
    // features, so they are no longer required or permitted here.
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'createdAt'])
        && data.uid == request.auth.uid
        && (data.get('email', null) == null || data.get('email', '') is string)
        && data.createdAt == request.time
        && (data.get('displayName', '') is string)
        && (data.get('photoURL', null) == null || data.get('photoURL', '') is string)
        && (data.get('isOnline', false) is bool)
        && (data.get('isAnonymous', false) is bool)
        && (data.get('lastActiveDate', '') is string);
    }

    // --- AI Tutor message validation ---
    function isValidAIMessage(data) {
      return data.keys().hasAll(['role', 'content', 'timestamp'])
        && data.role in ['user', 'assistant']
        && data.content is string
        && data.content.size() <= 20000
        && data.timestamp == request.time;
    }

    // =========================================================================
    // Collection matches
    // =========================================================================

    // AI Tutor conversations
    match /aiChats/{chatId} {
      allow read: if isSignedIn() && get(/databases/$(database)/documents/aiChats/$(chatId)).data.userId == request.auth.uid;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && existing().userId == request.auth.uid
        && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'lastMessage', 'lastUpdatedAt']);
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;

      match /messages/{messageId} {
        allow read: if isSignedIn() && get(/databases/$(database)/documents/aiChats/$(chatId)).data.userId == request.auth.uid;
        allow create: if isSignedIn()
          && get(/databases/$(database)/documents/aiChats/$(chatId)).data.userId == request.auth.uid
          && isValidAIMessage(incoming());
        allow update: if isSignedIn()
          && get(/databases/$(database)/documents/aiChats/$(chatId)).data.userId == request.auth.uid;
        allow delete: if isSignedIn()
          && get(/databases/$(database)/documents/aiChats/$(chatId)).data.userId == request.auth.uid;
      }
    }

    // User profiles
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidUser(incoming());
      allow update: if isOwner(userId)
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'photoURL', 'bio', 'isOnline', 'publicKey',
          'xp', 'badges', 'streak', 'lastActiveDate', 'weeklyXp',
          'createdAt', 'uid', 'email', 'isAnonymous', 'aiUses', 'updatedAt'
        ]);
      allow delete: if isOwner(userId);
    }

    match /userSettings/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /studySessions/{sessionId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Create Notes output (the collection the Notes Lab already used)
    match /notesLab/{noteId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Plan screen task list (one document per user; see lib/planner.ts)
    match /plannerTasks/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /performance_diagnostics/{logId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn();
    }

    match /analytics_events/{eventId} {
      allow create, read: if true;
    }
  }
}
